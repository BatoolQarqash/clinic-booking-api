# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# SQL Server 'sa' password. Must meet SQL Server complexity rules
# (8+ chars, upper + lower + digit + symbol). Avoid ';' and quotes,
# because it is embedded in a connection string.
SA_PASSWORD=<YOUR_STRONG_SA_PASSWORD>

# JWT signing key, at least 32 bytes. Generate with:  openssl rand -base64 64
# (keep it on a single line)
JWT_KEY=<YOUR_RANDOM_JWT_KEY>

# Optional: initial admin account, created on first startup if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<YOUR_ADMIN_PASSWORD>

# Expose Swagger UI at /swagger outside Development
ENABLE_SWAGGER=true
